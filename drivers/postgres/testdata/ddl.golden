-- create boolean
CREATE TABLE "t" (
  "c" BOOLEAN NOT NULL DEFAULT TRUE
);

-- create char
CREATE TABLE "t" (
  "c" CHAR(2) NOT NULL
);

-- create string
CREATE TABLE "t" (
  "c" VARCHAR(100) NOT NULL DEFAULT 'x'
);

-- create text
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create mediumText
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create longText
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create tinyText
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create tinyInteger
CREATE TABLE "t" (
  "c" SMALLINT NOT NULL
);

-- create smallInteger
CREATE TABLE "t" (
  "c" SMALLINT NOT NULL
);

-- create mediumInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create integer
CREATE TABLE "t" (
  "c" INTEGER NOT NULL DEFAULT 0
);

-- create bigInteger
CREATE TABLE "t" (
  "c" BIGINT NOT NULL
);

-- create unsignedInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create increments
CREATE TABLE "t" (
  "c" SERIAL NOT NULL,
  PRIMARY KEY ("c")
);

-- create id
CREATE TABLE "t" (
  "id" BIGSERIAL NOT NULL,
  PRIMARY KEY ("id")
);

-- create decimal
CREATE TABLE "t" (
  "c" NUMERIC(10,2) NOT NULL
);

-- create double
CREATE TABLE "t" (
  "c" DOUBLE PRECISION NOT NULL
);

-- create float
CREATE TABLE "t" (
  "c" DOUBLE PRECISION NOT NULL
);

-- create date
CREATE TABLE "t" (
  "c" DATE NOT NULL
);

-- create dateTime
CREATE TABLE "t" (
  "c" TIMESTAMP(3) NOT NULL
);

-- create dateTimeTz
CREATE TABLE "t" (
  "c" TIMESTAMP WITH TIME ZONE NOT NULL
);

-- create time
CREATE TABLE "t" (
  "c" TIME NOT NULL
);

-- create timestamp
CREATE TABLE "t" (
  "c" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- create timestampTz
CREATE TABLE "t" (
  "c" TIMESTAMP WITH TIME ZONE NULL
);

-- create year
CREATE TABLE "t" (
  "c" SMALLINT NOT NULL
);

-- create binary
CREATE TABLE "t" (
  "c" BYTEA NOT NULL
);

-- create json
CREATE TABLE "t" (
  "c" JSON NOT NULL
);

-- create jsonb
CREATE TABLE "t" (
  "c" JSONB NOT NULL
);

-- create uuid
CREATE TABLE "t" (
  "c" UUID NOT NULL
);

-- create ulid
CREATE TABLE "t" (
  "c" CHAR(26) NOT NULL
);

-- create enum
CREATE TABLE "t" (
  "c" VARCHAR(255) NOT NULL CHECK ("c" IN ('a', 'b'))
);

-- create set
ERROR: schema: column "c": postgres: set type is not natively supported (no equivalent of MySQL SET); use []string/JSONB and application-level validation

-- create macAddress
CREATE TABLE "t" (
  "c" MACADDR NOT NULL
);

-- create ipAddress
CREATE TABLE "t" (
  "c" INET NOT NULL
);

-- create geometry
CREATE TABLE "t" (
  "c" geometry NOT NULL
);

-- create vector
CREATE TABLE "t" (
  "c" vector(3) NOT NULL
);

-- create comment
CREATE TABLE "t" (
  "c" VARCHAR(255) NOT NULL
);

-- create foreign key
CREATE TABLE "t" (
  "user_id" BIGINT NOT NULL,
  CONSTRAINT "t_user_id_foreign" FOREIGN KEY ("user_id") REFERENCES "users" ("id") ON DELETE CASCADE
);

-- create indexes
CREATE TABLE "t" (
  "a" VARCHAR(255) NOT NULL,
  "b" VARCHAR(255) NOT NULL,
  CONSTRAINT "t_a_b_unique" UNIQUE ("a", "b")
);
CREATE INDEX "t_b_index" ON "t" ("b");

-- alter add, drop, rename
ALTER TABLE "t" ADD COLUMN "nick" VARCHAR(255) NULL;
ALTER TABLE "t" DROP COLUMN "old";
ALTER TABLE "t" RENAME COLUMN "a" TO "b";

-- alter change column
ALTER TABLE "t" ALTER COLUMN "nick" TYPE VARCHAR(50), ALTER COLUMN "nick" SET NOT NULL;

-- alter indexes and keys
ALTER TABLE "t" ADD COLUMN "team_id" BIGINT NOT NULL;
ALTER TABLE "t" ADD CONSTRAINT "t_email_unique" UNIQUE ("email");
DROP INDEX "t_nick_index";
ALTER TABLE "t" ADD CONSTRAINT "t_team_id_foreign" FOREIGN KEY ("team_id") REFERENCES "teams" ("id");
ALTER TABLE "t" DROP CONSTRAINT "t_company_id_foreign";


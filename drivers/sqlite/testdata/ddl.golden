-- create macAddress
CREATE TABLE "t" (
  "c" VARCHAR(17) NOT NULL
);

-- create ipAddress
CREATE TABLE "t" (
  "c" VARCHAR(45) NOT NULL
);

-- create geometry
ERROR: schema: column "c": sqlite: type geometry is not supported without the SpatiaLite extension

-- create vector
ERROR: schema: column "c": sqlite: vector type is not supported without an extension (e.g. sqlite-vec)

-- create comment
CREATE TABLE "t" (
  "c" VARCHAR(255) NOT NULL
);

-- create foreign key
CREATE TABLE "t" (
  "user_id" INTEGER NOT NULL,
  CONSTRAINT "t_user_id_foreign" FOREIGN KEY ("user_id") REFERENCES "users" ("id") ON DELETE CASCADE
);

-- create indexes
CREATE TABLE "t" (
  "a" VARCHAR(255) NOT NULL,
  "b" VARCHAR(255) NOT NULL,
  CONSTRAINT "t_a_b_unique" UNIQUE ("a", "b")
);
CREATE INDEX "t_b_index" ON "t" ("b");

-- alter add, drop, rename
ALTER TABLE "t" ADD COLUMN "nick" VARCHAR(255) NULL;
ALTER TABLE "t" DROP COLUMN "old";
ALTER TABLE "t" RENAME COLUMN "a" TO "b";

-- alter change column
ERROR: schema: changing column "nick": sqlite: ALTER COLUMN is not supported by SQLite directly (column "nick", table "t"); recreate the table manually (CREATE new -> INSERT SELECT -> DROP old -> RENAME)

-- alter unique in alter
ALTER TABLE "t" ADD COLUMN "nick" VARCHAR(255) NULL;
CREATE UNIQUE INDEX "t_nick_unique" ON "t" ("nick");
CREATE UNIQUE INDEX "t_email_unique" ON "t" ("email");


-- create boolean
CREATE TABLE "t" (
  "c" INTEGER NOT NULL DEFAULT 1
);

-- create char
CREATE TABLE "t" (
  "c" CHAR(2) NOT NULL
);

-- create string
CREATE TABLE "t" (
  "c" VARCHAR(100) NOT NULL DEFAULT 'x'
);

-- create text
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create mediumText
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create longText
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create tinyText
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create tinyInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create smallInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create mediumInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create integer
CREATE TABLE "t" (
  "c" INTEGER NOT NULL DEFAULT 0
);

-- create bigInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create unsignedInteger
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create increments
CREATE TABLE "t" (
  "c" INTEGER NOT NULL,
  PRIMARY KEY ("c")
);

-- create id
CREATE TABLE "t" (
  "id" INTEGER NOT NULL,
  PRIMARY KEY ("id")
);

-- create decimal
CREATE TABLE "t" (
  "c" NUMERIC(10,2) NOT NULL
);

-- create double
CREATE TABLE "t" (
  "c" REAL NOT NULL
);

-- create float
CREATE TABLE "t" (
  "c" REAL NOT NULL
);

-- create date
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create dateTime
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create dateTimeTz
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create time
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create timestamp
CREATE TABLE "t" (
  "c" TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- create timestampTz
CREATE TABLE "t" (
  "c" TEXT NULL
);

-- create year
CREATE TABLE "t" (
  "c" INTEGER NOT NULL
);

-- create binary
CREATE TABLE "t" (
  "c" BLOB NOT NULL
);

-- create json
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create jsonb
CREATE TABLE "t" (
  "c" TEXT NOT NULL
);

-- create uuid
CREATE TABLE "t" (
  "c" CHAR(36) NOT NULL
);

-- create ulid
CREATE TABLE "t" (
  "c" CHAR(26) NOT NULL
);

-- create enum
CREATE TABLE "t" (
  "c" VARCHAR(255) NOT NULL CHECK ("c" IN ('a', 'b'))
);

-- create set
